# Environment variables template
# Copy this file to .env and fill in your actual values

# API Keys
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here
FRED_API_KEY=your_fred_api_key_here
NEWS_API_KEY=your_news_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
SEC_API_KEY=your_sec_api_key_here

# Database Configuration
DATABASE_URL=sqlite:///./financial_analytics.db
# For PostgreSQL: postgresql://username:password@localhost:5432/financial_analytics

# Application Settings
DEBUG=True
LOG_LEVEL=INFO
SECRET_KEY=your_secret_key_here

# API Rate Limiting
ALPHA_VANTAGE_CALLS_PER_MINUTE=5
NEWS_API_CALLS_PER_DAY=1000
OPENAI_MAX_TOKENS=4000

# Data Storage Paths
DATA_RAW_PATH=./data/raw
DATA_PROCESSED_PATH=./data/processed
DATA_EXTERNAL_PATH=./data/external

# Model Configuration
ML_MODEL_PATH=./models
ENABLE_GPU=False
MODEL_RETRAIN_FREQUENCY=7  # days

# Dashboard Configuration
STREAMLIT_PORT=8501
FASTAPI_PORT=8000

# Cache Settings
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=3600  # seconds
